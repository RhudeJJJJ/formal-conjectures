theorem actual_graph_bounds :
    ((451226335/67108864) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((3609810785/536870912) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
