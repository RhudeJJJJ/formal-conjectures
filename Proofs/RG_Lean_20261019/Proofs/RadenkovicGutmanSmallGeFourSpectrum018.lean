theorem actual_graph_bounds :
    ((19486539051/2684354560) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((9743269683/1342177280) : ℝ) := by
  have hi : graphDecidable=
