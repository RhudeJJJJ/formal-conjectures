    ((11361818403/1476395008) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/11) ∧
    stopLoss (laplacianSpectrum graph) (2-2/11) ≤ ((355056833/46137344) : ℝ) := by
  have hi : graphDecidable=
