    ((44730227337/5905580032) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/11) ∧
    stopLoss (laplacianSpectrum graph) (2-2/11) ≤ ((44730228349/5905580032) : ℝ) := by
  have hi : graphDecidable=
