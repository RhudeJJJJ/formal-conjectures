theorem actual_graph_bounds :
    ((70389719993/6979321856) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/13) ∧
    stopLoss (laplacianSpectrum graph) (2-2/13) ≤ ((17597430437/1744830464) : ℝ) := by
