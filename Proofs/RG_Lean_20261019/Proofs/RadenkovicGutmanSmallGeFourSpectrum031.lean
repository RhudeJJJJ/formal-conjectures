theorem actual_graph_bounds :
    ((625406929/83886080) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((5003255537/671088640) : ℝ) := by
