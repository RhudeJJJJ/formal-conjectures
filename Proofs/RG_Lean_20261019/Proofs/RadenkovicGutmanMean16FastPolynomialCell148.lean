theorem geometry_checked : FastPolynomialPaymentCell.accepts us vs js ns sep cell geometry = true := by decide +kernel
theorem payment_checked : PolynomialPaymentCell.paymentAccepts cell = true := by
  rw [PolynomialPaymentCell.paymentAccepts,decide_eq_true_eq]
  constructor
  · apply Polynomial.funext
    intro t
    norm_num [cell,PolynomialPathMap.ofList,GeneralPathPolynomialPayments.paymentPolynomial]
    ring
