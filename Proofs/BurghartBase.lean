def route1 (u v : Fin 28) : List (Fin 28) := ((routes1.getD u.val []).getD v.val [])
def route2 (u v : Fin 28) : List (Fin 28) := ((routes2.getD u.val []).getD v.val [])

structure RoutesOK (G : SimpleGraph (Fin 28)) (r : Fin 28 → Fin 28 → List (Fin 28)) : Prop where
  first : ∀ u v, (r u v).head? = some u
  last : ∀ u v, (r u v).getLast? = some v
  chain : ∀ u v, (r u v).IsChain G.Adj
  nodup : ∀ u v, (r u v).Nodup

theorem route1_ok : RoutesOK T1 route1 := by
  constructor <;> decide +kernel
theorem route2_ok : RoutesOK T2 route2 := by
  constructor <;> decide +kernel

namespace RoutesOK
variable {G : SimpleGraph (Fin 28)} {r : Fin 28 → Fin 28 → List (Fin 28)}
theorem ne_nil (h : RoutesOK G r) (u v) : r u v ≠ [] := by
  intro he
  have hh := h.first u v
  simp [he] at hh
def walk (h : RoutesOK G r) (u v) : G.Walk u v :=
  (Walk.ofSupport (r u v) (h.ne_nil u v) (h.chain u v)).copy
    (by have hh := h.first u v; rw [List.head?_eq_some_head (h.ne_nil u v)] at hh; exact Option.some.inj hh)
    (by have ht := h.last u v; rw [List.getLast?_eq_some_getLast (h.ne_nil u v)] at ht; exact Option.some.inj ht)
theorem walk_support (h : RoutesOK G r) (u v) : (h.walk u v).support = r u v := by
  simp [walk, Walk.support_copy, Walk.support_ofSupport]
theorem walk_path (h : RoutesOK G r) (u v) : (h.walk u v).IsPath := by
  rw [Walk.isPath_def, h.walk_support]
  exact h.nodup u v
theorem connected (h : RoutesOK G r) : G.Connected := by
  exact Connected.mk (fun u v => (h.walk u v).reachable)
theorem dist_eq (h : RoutesOK G r) (ht : G.IsTree) (u v) :
    G.dist u v = (r u v).length - 1 := by
  obtain ⟨p,hp,hlen⟩ := ht.connected.exists_path_of_dist u v
  have he : h.walk u v = p := (ht.existsUnique_path u v).unique (h.walk_path u v) hp
  rw [← hlen, ← he]
  simp [walk, Walk.length_copy, Walk.length_ofSupport]
end RoutesOK

theorem T1_tree : T1.IsTree := by
  classical
  apply isTree_iff_connected_and_card.mpr
  refine ⟨route1_ok.connected, ?_⟩
  have hc : T1.edgeFinset.card + 1 = 28 := by decide +kernel
  simpa only [Nat.card_eq_fintype_card, ← edgeFinset_card, Fintype.card_fin] using hc
theorem T2_tree : T2.IsTree := by
  classical
  apply isTree_iff_connected_and_card.mpr
  refine ⟨route2_ok.connected, ?_⟩
  have hc : T2.edgeFinset.card + 1 = 28 := by decide +kernel
  simpa only [Nat.card_eq_fintype_card, ← edgeFinset_card, Fintype.card_fin] using hc

#print axioms T1_tree
#print axioms T2_tree

def walkCount {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] : ℕ → V → ℕ
  | 0, _ => 1
  | k+1, v => ∑ w, if G.Adj v w then walkCount G k w else 0

theorem walkCount_iso {V W : Type*} [Fintype V] [Fintype W]
    {G : SimpleGraph V} {H : SimpleGraph W} [DecidableRel G.Adj] [DecidableRel H.Adj]
    (e : G ≃g H) (k : ℕ) : ∀ v, walkCount G k v = walkCount H k (e v) := by
  induction k with
  | zero => intro v; rfl
  | succ k ih =>
    intro v
    simp only [walkCount]
    refine Fintype.sum_equiv e.toEquiv _ _ (fun w => ?_)
    change (if G.Adj v w then walkCount G k w else 0) =
      (if H.Adj (e v) (e w) then walkCount H k (e w) else 0)
    simp only [e.map_adj_iff, ih w]

theorem walkCount_T1 : walkCount T1 9 0 = 3846 := by decide +kernel
theorem walkCount_T2 : walkCount T2 9 0 = 3849 := by decide +kernel
theorem no_rooted_iso (e : T1 ≃g T2) (he : e 0 = 0) : False := by
  have h := walkCount_iso e 9 0
  rw [he,walkCount_T1,walkCount_T2] at h
  contradiction

#print axioms no_rooted_iso

end BurghartCertificate



namespace BurghartCertificate
open SimpleGraph Finset


theorem connected_iff_routes (G : SimpleGraph (Fin 28))
    (r : Fin 28 → Fin 28 → List (Fin 28)) (hr : RoutesOK G r)
    (ht : G.IsTree) (S : Finset (Fin 28)) (h0 : (0:Fin 28) ∈ S) :
    (G.induce (S : Set (Fin 28))).Connected ↔
      ∀ v ∈ S, (r 0 v).toFinset ⊆ S := by
  classical
  constructor
  · intro hc v hv w hw
    obtain ⟨p,hp,_⟩ := hc.exists_path_of_dist ⟨0,h0⟩ ⟨v,hv⟩
    let q : G.Walk 0 v := p.map (Embedding.induce (S : Set (Fin 28))).toHom
    have hq : q.IsPath := hp.map Subtype.val_injective
    have he : hr.walk 0 v = q := (ht.existsUnique_path 0 v).unique (hr.walk_path 0 v) hq
    have hw' : w ∈ (hr.walk 0 v).support := by simpa [hr.walk_support] using hw
    rw [he] at hw'
    change w ∈ (p.map (Embedding.induce (S:Set (Fin 28))).toHom).support at hw'
    rw [Walk.support_map] at hw'
    obtain ⟨u,_,hu⟩ := List.mem_map.mp hw'
    exact hu ▸ u.property
  · intro hc
    have : Nonempty {v : Fin 28 // v ∈ S} := ⟨⟨0,h0⟩⟩
    have reach (v : {v : Fin 28 // v ∈ S}) :
        (G.induce (S : Set (Fin 28))).Reachable ⟨0,h0⟩ v := by
      have hs : ∀ w ∈ (hr.walk 0 v.val).support, w ∈ (S:Set (Fin 28)) := by
        intro w hw
        exact hc v.val v.property (by simpa [hr.walk_support] using hw)
      exact ((hr.walk 0 v.val).induce (S:Set (Fin 28)) hs).reachable
    exact Connected.mk (fun v w => (reach v).symm.trans (reach w))

def distanceCode (r : Fin 28 → Fin 28 → List (Fin 28)) (u v : Fin 28) : ℕ := (r u v).length - 1
def leavesCode (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj]
    (d : Fin 28 → Fin 28 → ℕ) : Finset (Fin 28) :=
  univ.filter fun v => ¬ ∃ w, G.Adj v w ∧ d 0 w = d 0 v + 1
def fringeCode (L : Finset (Fin 28)) (d : Fin 28 → Fin 28 → ℕ) (v : Fin 28) :=
  L.filter fun l => d 0 v + d v l = d 0 l
def pathsCode (d : Fin 28 → Fin 28 → ℕ) (v : Fin 28) (A : Finset (Fin 28)) :=
  univ.filter fun w => ∃ l ∈ A, d v w + d w l = d v l
def boundaryCode (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj] (S : Finset (Fin 28)) :=
  if S = ∅ then {0} else univ.filter fun v => v ∉ S ∧ ∃ u ∈ S, G.Adj u v
def ClosedCode (r : Fin 28 → Fin 28 → List (Fin 28)) (S : Finset (Fin 28)) : Prop :=
  S = ∅ ∨ ((0:Fin 28) ∈ S ∧ ∀ v ∈ S, (r 0 v).toFinset ⊆ S)
instance (r : Fin 28 → Fin 28 → List (Fin 28)) (S : Finset (Fin 28)) : Decidable (ClosedCode r S) :=
  inferInstanceAs (Decidable (S = ∅ ∨ ((0:Fin 28) ∈ S ∧ ∀ v ∈ S, (r 0 v).toFinset ⊆ S)))

theorem leaves_eq_code (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj]
    (r : Fin 28 → Fin 28 → List (Fin 28)) (hr : RoutesOK G r) (ht : G.IsTree) :
    Burghart.MPolynomial.leaves G 0 = leavesCode G (distanceCode r) := by
  classical
  unfold Burghart.MPolynomial.leaves leavesCode
  simp only [hr.dist_eq ht]
  rfl

theorem fringe_eq_code (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj]
    (r : Fin 28 → Fin 28 → List (Fin 28)) (hr : RoutesOK G r) (ht : G.IsTree) (v : Fin 28) :
    Burghart.MPolynomial.fringeLeaves G 0 v =
      fringeCode (leavesCode G (distanceCode r)) (distanceCode r) v := by
  classical
  unfold Burghart.MPolynomial.fringeLeaves fringeCode
  rw [leaves_eq_code G r hr ht]
  simp only [hr.dist_eq ht]
  rfl

theorem paths_eq_code (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj]
    (r : Fin 28 → Fin 28 → List (Fin 28)) (hr : RoutesOK G r) (ht : G.IsTree)
    (v : Fin 28) (A : Finset (Fin 28)) :
    Burghart.MPolynomial.leafPathUnion G v A = pathsCode (distanceCode r) v A := by
  classical
  unfold Burghart.MPolynomial.leafPathUnion pathsCode
  simp only [hr.dist_eq ht]
  rfl

open scoped Classical in
theorem admissibles_eq_code (G : SimpleGraph (Fin 28)) [DecidableRel G.Adj]
    (r : Fin 28 → Fin 28 → List (Fin 28)) (hr : RoutesOK G r) (ht : G.IsTree) :
    univ.powerset.filter (Burghart.MPolynomial.IsAdmissible G 0) =
      (univ \ leavesCode G (distanceCode r)).powerset.filter (ClosedCode r) := by
  classical
  ext S
  simp only [mem_filter,mem_powerset,subset_univ,true_and]
  constructor
  · rintro (he | ⟨h0,hc,hd⟩)
    · subst S; exact ⟨empty_subset _,Or.inl rfl⟩
    · refine ⟨?_,Or.inr ⟨h0,(connected_iff_routes G r hr ht S h0).mp hc⟩⟩
      intro v hv
      refine mem_sdiff.mpr ⟨mem_univ v,?_⟩
      intro hl
      exact Finset.disjoint_left.mp hd hv ((leaves_eq_code G r hr ht).symm ▸ hl)
  · rintro ⟨hs,he | ⟨h0,hc⟩⟩
    · exact Or.inl he
    · refine Or.inr ⟨h0,(connected_iff_routes G r hr ht S h0).mpr hc,?_⟩
      apply Finset.disjoint_left.mpr
      intro v hv hl
      have hnot := (mem_sdiff.mp (hs hv)).2
      exact hnot (leaves_eq_code G r hr ht ▸ hl)


end BurghartCertificate
