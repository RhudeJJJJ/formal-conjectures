theorem cover_checked : FastArmCover.accepts 2 0 4 slice.lower slice.upper 0 1 0 1 slice.bound slice.cover=true := by
  change decide (FastNestedCellData.accepts 2 0 4 cell=true ∧ FastRectangularCell.shape cell (167/6400) (337/12800) 0 1 0 1=true ∧ cell.payment≤cell.payment)=true
  rw [decide_eq_true_eq]
