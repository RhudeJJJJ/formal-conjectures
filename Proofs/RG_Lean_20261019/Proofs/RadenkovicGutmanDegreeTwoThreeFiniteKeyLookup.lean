def lookupTable : ℕ → Array (Array (Array ℕ))
  | 0 => lookupLevel0
  | 1 => lookupLevel1
  | 2 => lookupLevel2
  | 3 => lookupLevel3
  | 4 => lookupLevel4
  | 5 => lookupLevel5
  | 6 => lookupLevel6
  | 7 => lookupLevel7
  | 8 => lookupLevel8
  | 9 => lookupLevel9
  | 10 => lookupLevel10
  | _ => #[]
def lookup (n i p q : ℕ) : ℕ :=
  (((lookupTable n).getD i #[]).getD p #[]).getD q 8887

def coveredIndexed (n start count : ℕ) : Bool :=
  decide (∀ i : Fin count, ∀ p q : Fin 13,
    eligible n (start+i.val) p.val q.val=true →
      keyArray[lookup n (start+i.val) p.val q.val]?=
        some (⟨n,start+i.val,p.val,q.val⟩ : Key))

theorem indexed_range_sound (n start count : ℕ) (hc : coveredIndexed n start count=true)
    (i : ℕ) (p q : Fin 13) (hlo : start≤i) (hhi : i<start+count)
    (he : eligible n i p.val q.val=true) : (⟨n,i,p.val,q.val⟩ : Key) ∈ keys := by
  have hh := of_decide_eq_true hc (⟨i-start,by omega⟩ : Fin count) p q
  have hi : start+(i-start)=i := by omega
  dsimp only [Fin.val_mk] at hh
  rw [hi] at hh
  rw [← keyArray_toList]
  exact Array.mem_toList_iff.mpr (Array.mem_of_getElem? (hh he))
