    Polynomial.C_ofNat]
  
theorem actual_graph_bounds :
    ((211197707847/18253611008) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/17) ∧
    stopLoss (laplacianSpectrum graph) (2-2/17) ≤ ((211197712607/18253611008) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
  have hp := graph_charpoly.trans factorization
  rw [hi] at hp ⊢
  have h := RationalSpectralBounds.graph_bounds graph boxes boxes_accepted hp
    (2-2/17) (211197707847/18253611008) (211197712607/18253611008) (by decide +kernel)
  norm_num at h ⊢
  exact h
