noncomputable def geometry : IntegerPolynomialPaymentCell.Geometry := {
 left:=600901,width:=120180,den:=262144,localDen:=442721857769029238784,lowerC:=511980559924274921472,s:=[11770076912623288320,-5269162690153021440,1133877663583174656],L:=[527166277273985491191,-16292669652364951552,795575578961903616,420369129527050240,-108992405818048512],transformed:=fun i => IntegerPolynomialPaymentCell.affine (WideAnchor256Source.source.poly i) 600901 120180 262144
