theorem actual_graph_bounds :
    ((18507267261/2684354560) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((2313408447/335544320) : ℝ) := by
