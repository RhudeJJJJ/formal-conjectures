theorem actual_graph_bounds :
    ((69255148997/6979321856) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/13) ∧
    stopLoss (laplacianSpectrum graph) (2-2/13) ≤ ((2164223461/218103808) : ℝ) := by
