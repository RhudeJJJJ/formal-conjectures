theorem actual_graph_bounds :
    ((58636628187/6979321856) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/13) ∧
    stopLoss (laplacianSpectrum graph) (2-2/13) ≤ ((58636630293/6979321856) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
  have hp := graph_charpoly.trans factorization
  rw [hi] at hp ⊢
  have h := FactoredRoots.graph_stopLoss_bounds graph boxes boxes_accepted hp (2-2/13)
