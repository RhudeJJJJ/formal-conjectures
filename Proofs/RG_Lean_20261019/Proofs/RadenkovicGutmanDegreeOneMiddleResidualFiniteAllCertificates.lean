namespace Gebendorfer.RadenkovicGutman.DegreeOneMiddleResidualFiniteAllCertificates
open SmallGeFourKeys DegreeOneMiddleResidualFiniteKeys
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option backward.isDefEq.respectTransparency false
noncomputable section
theorem certified_all_keys : ∀ (k : SmallGeFourKeys.Key), k ∈ DegreeOneMiddleResidualFiniteKeys.keys → SmallGeFourKeys.Certified k :=
  DegreeOneMiddleResidualFiniteListAssembly.of_batches SmallGeFourKeys.Certified
    certified_keys000 certified_keys001 certified_keys002 certified_keys003 certified_keys004
    certified_keys005 certified_keys006 certified_keys007 certified_keys008 certified_keys009
    certified_keys010 certified_keys011 certified_keys012 certified_keys013 certified_keys014
    certified_keys015 certified_keys016 certified_keys017 certified_keys018 certified_keys019
    certified_keys020 certified_keys021 certified_keys022 certified_keys023 certified_keys024
theorem certificates : DegreeOneMiddleResidualFiniteTransfer.Certificates := by
  intro n i p q hk
  exact certified_all_keys ⟨n,i,p,q⟩ hk
theorem residual_cases : DegreeOneMiddleAnchors.ResidualCases :=
  DegreeOneMiddleResidualFiniteTransfer.residual_cases_of_certificates certificates
#print axioms residual_cases
#print axioms certified_all_keys
#print axioms certificates
end
end Gebendorfer.RadenkovicGutman.DegreeOneMiddleResidualFiniteAllCertificates
