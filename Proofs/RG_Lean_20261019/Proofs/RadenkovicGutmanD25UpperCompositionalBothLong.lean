    (hp : ArmClasses.classify p=4) (hq : ArmClasses.classify q=4) :
    (reserve : ℝ)<ActualFusionIntegral.normalizedIntegral G u p q 2 :=
  PaidFixedClassIntegral.normalized_target G u p q 25 (by decide) hd 4 4 hp hq
