theorem actual_graph_bounds :
    ((1138054363/109051904) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/13) ∧
    stopLoss (laplacianSpectrum graph) (2-2/13) ≤ ((18208870159/1744830464) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
