def slice : FastArmCoverIntegral.Slice := ⟨.leaf cell,8,(128/15),cell.payment⟩
theorem cover_checked : FastArmCover.accepts 2 0 4 slice.lower slice.upper 0 1 0 1 slice.bound slice.cover=true := by
  change decide (FastNestedCellData.accepts 2 0 4 cell=true ∧ FastRectangularCell.shape cell 8 (128/15) 0 1 0 1=true ∧ cell.payment≤cell.payment)=true
  rw [decide_eq_true_eq]
  exact ⟨checked,by decide +kernel,le_rfl⟩
theorem slice_checked : FastArmCoverIntegral.accepts 2 0 4 slice=true :=
  FastArmCoverIntegral.accepts_of_checks 2 0 4 slice (by decide +kernel) (by decide +kernel) cover_checked
