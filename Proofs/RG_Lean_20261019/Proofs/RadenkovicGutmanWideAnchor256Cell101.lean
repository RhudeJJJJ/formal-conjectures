  b := (931671/2097152)
  s := [(6194058717823/17592186044416),(-818518408523/17592186044416),(29551594133/8796093022208)]
  L := [(57090395454034410553/73786976294838206464),(2680961023955/26388279066624),(-30593416631/4398046511104),(-109280033/1649267441664),(11090291/274877906944)]
