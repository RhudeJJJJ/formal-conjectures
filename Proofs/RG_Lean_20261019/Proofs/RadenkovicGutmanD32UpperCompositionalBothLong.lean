open scoped Classical
noncomputable section
theorem normalized_target {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (u : V) (p q : ℕ) (hd : G.degree u=32)
    (hp : ArmClasses.classify p=4) (hq : ArmClasses.classify q=4) :
    (reserve : ℝ)<ActualFusionIntegral.normalizedIntegral G u p q 2 :=
  PaidFixedClassIntegral.normalized_target G u p q 32 (by decide) hd 4 4 hp hq
    reserve partition partition_checked budget_checked
end
