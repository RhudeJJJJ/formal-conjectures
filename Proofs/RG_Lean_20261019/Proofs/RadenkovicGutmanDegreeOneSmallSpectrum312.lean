    ((5409821599/738197504) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/11) ∧
    stopLoss (laplacianSpectrum graph) (2-2/11) ≤ ((10819643451/1476395008) : ℝ) := by
  have hi : graphDecidable=
