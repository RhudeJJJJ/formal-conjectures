theorem matrix_certificates : ∀ k : Fin 10,
    CheckedCharpoly.acceptsLU
      (CheckedCharpoly.shifted (CheckedCharpoly.laplacian (fun i j => decide (graph.Adj i j)))
        (CheckedCharpoly.sample k)) (lowerMatrices k) (upperMatrices k)
      (CheckedRoots.eval coefficients (CheckedCharpoly.sample k))=true := by decide +kernel
theorem graph_charpoly : (graph.lapMatrix ℝ).charpoly=CheckedRoots.polynomial coefficients :=
  FiniteSpectralCertificates.graph_polynomial graph coefficients (by decide)
    lowerMatrices upperMatrices matrix_certificates
def boxes : List FactoredRoots.Box := [{coefficients := [0,9,-98,371,-668,641,-344,103,-16,1],count := 9,lower := ![(-15/536870912),(49990921/268435456),(258866815/536870912),(378105305/536870912),(755535707/536870912),(286389433/134217728),(191477963/67108864),(237378581/67108864),(2521034745/536870912)],upper := ![(1/134217728),(99981861/536870912),(129433417/268435456),(94526331/134217728),(377767863/268435456),(1145557751/536870912),(1531823723/536870912),(1899028667/536870912),(630258691/134217728)],copies := 1}]
