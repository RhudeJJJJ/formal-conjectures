    ((9942263149/1342177280) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((9942263359/1342177280) : ℝ) := by
