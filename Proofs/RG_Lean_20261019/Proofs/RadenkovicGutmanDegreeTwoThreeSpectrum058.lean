  have hp := graph_charpoly.trans factorization
  rw [hi] at hp ⊢
  have h := RationalSpectralBounds.graph_bounds graph boxes boxes_accepted hp
    (2-2/9) (8597372009/1207959552) (17194744189/2415919104) (by decide +kernel)
  norm_num at h ⊢
