theorem J_link : J = pointValue LongArmBothFamily.jData 4 := by decide +kernel
theorem J_eval (v t y : ℝ) : eval J ![v,t,y^2] = LongArmBothFamily.jp 4 y v t := by
  rw [J_link, pointValue_sound]
  unfold LongArmBothFamily.jp
  congr 1
def Jr : Poly 3 := reverseLast 3 42 J
def useJ (inverse : Bool) : Poly 3 := if inverse then Jr else J
#print axioms J_link
#print axioms J_eval
theorem actual_margin (inverse : Bool) (y v t L s : ℝ) (hy : 0 < y)
    (h : 0 ≤ eval (useJ inverse) ![v,t,LongArmCoordinates.coordinate inverse y]-L*
      ((1+s)*eval (useU inverse) ![v,t,LongArmCoordinates.coordinate inverse y]+
        (1+1/s)*eval (useV inverse) ![v,t,LongArmCoordinates.coordinate inverse y])) :
    0 ≤ LongArmBothFamily.jp 4 y v t-L*((1+s)*LongArmBothFamily.up 4 y v t+(1+1/s)*LongArmBothFamily.vp 4 y v t) := by
  cases inverse with
  | false =>
    change 0 ≤ eval J ![v,t,y^2]-L*((1+s)*eval U ![v,t,y^2]+(1+1/s)*eval V ![v,t,y^2]) at h
    simpa only [U_eval, V_eval, J_eval] using h
  | true =>
    have hh := reverse_margin_sound 3 42 U V J (by decide +kernel) (by decide +kernel) (by decide +kernel)
      L s ![v,t,y^2] (by change 0 < y^2; positivity) h
    simpa only [U_eval, V_eval, J_eval] using hh
#print axioms actual_margin
end
