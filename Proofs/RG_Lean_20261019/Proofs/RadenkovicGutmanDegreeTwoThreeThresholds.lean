def threshold (d p q : ℕ) : ℕ :=
  if d=2 then threshold2 (classify p) (classify q)
  else threshold3 (classify p) (classify q)

/-- Every unpaid original degree-two/three case has a core covered by the
already checked catalogue through order eleven. This bound is for all arms. -/
theorem unpaid_core_order (d m p q : ℕ) (hd : d=2 ∨ d=3)
    (h : m+p+q+2<threshold d p q) : m≤11 := by
  have hp : (classify p).val≤p := Nat.min_le_left p 4
  have hq : (classify q).val≤q := Nat.min_le_left q 4
  rcases hd with rfl | rfl
  · change m+p+q+2<threshold2 (classify p) (classify q) at h
    have ht := table2_bound (classify p) (classify q)
    omega
  · change m+p+q+2<threshold3 (classify p) (classify q) at h
    have ht := table3_bound (classify p) (classify q)
    omega
#print axioms unpaid_core_order
end Gebendorfer.RadenkovicGutman.DegreeTwoThreeThresholds
