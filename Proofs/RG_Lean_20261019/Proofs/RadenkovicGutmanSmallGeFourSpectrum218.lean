theorem actual_graph_bounds :
    ((5275251773/536870912) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/12) ∧
    stopLoss (laplacianSpectrum graph) (2-2/12) ≤ ((659406481/67108864) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
