theorem v_nonneg (h u a b : ℝ) (hh : h ∈ Set.Icc (0 : ℝ) (1/46))
    (hu : u ∈ Set.Icc (0 : ℝ) 2) (ha : a ∈ Set.Icc (0 : ℝ) 1)
