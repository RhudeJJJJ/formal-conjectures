  change decide (FastNestedCellData.accepts 4 2 4 cell=true ∧ FastRectangularCell.shape cell (4/3) (16/11) 0 1 0 1=true ∧ cell.payment≤cell.payment)=true
  rw [decide_eq_true_eq]
  exact ⟨checked,by decide +kernel,le_rfl⟩
theorem slice_checked : FastArmCoverIntegral.accepts 4 2 4 slice=true :=
  FastArmCoverIntegral.accepts_of_checks 4 2 4 slice (by decide +kernel) (by decide +kernel) cover_checked
