    ((44846970679/5905580032) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/11) ∧
    stopLoss (laplacianSpectrum graph) (2-2/11) ≤ ((5605871493/738197504) : ℝ) := by
