theorem actual_graph_bounds :
    ((2630651877/335544320) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((21045215331/2684354560) : ℝ) := by
  have hi : graphDecidable=
