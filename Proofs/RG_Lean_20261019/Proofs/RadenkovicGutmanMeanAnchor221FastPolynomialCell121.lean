theorem geometry_checked : FastPolynomialPaymentCell.accepts us vs js ns sep cell geometry = true := by decide +kernel
theorem payment_checked : PolynomialPaymentCell.paymentAccepts cell = true := by
  rw [PolynomialPaymentCell.paymentAccepts,decide_eq_true_eq]
  constructor
  · apply Polynomial.funext
    intro t
    norm_num [cell,PolynomialPathMap.ofList,GeneralPathPolynomialPayments.paymentPolynomial]
    ring
  · norm_num [cell]
theorem logarithm_checked : RationalLog.accepts cell.c cell.R cell.k cell.n = true := by decide +kernel
theorem primitive_checked : RationalPolynomialIntegral.accepts cell.pay cell.primitive 0 1 cell.unitIntegral = true := by
  rw [RationalPolynomialIntegral.accepts,decide_eq_true_eq]
  constructor
  · apply Polynomial.funext
    intro t
    norm_num [cell,PolynomialPathMap.ofList]
    ring
  · norm_num [cell,PolynomialPathMap.ofList]

theorem actual_integral {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) (u : V) (hd : G.degree u = 1) :
    (cell.total : ℝ) ≤ ∫ y : ℝ in (cell.a : ℝ)..(cell.b : ℝ),
      MixedGraphIntegral.logarithm (CoreQuotient.source G u 0 0)
        (CoreQuotient.fused G u 0 0) (44/23) y := by
  have hf := TailIntegral.interval_integrable_of_Ioi
    (ActualFusionIntegral.logarithm_integrable G u 0 0 (44/23))
    (a := (cell.a : ℝ)) (b := (cell.b : ℝ)) (by norm_num [cell]) (by norm_num [cell])
  simpa only [Rat.cast_div,Rat.cast_ofNat] using
    (FastPolynomialPaymentCell.actual_integral_lower (44/23) 0 0 as bs cs es us vs js ns sep
      path_checked norms_checked cell geometry geometry_checked payment_checked logarithm_checked primitive_checked G u hd
      (by simpa only [Rat.cast_div,Rat.cast_ofNat] using hf))

