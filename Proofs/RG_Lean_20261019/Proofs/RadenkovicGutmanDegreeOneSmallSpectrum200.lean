    ((10789400219/1476395008) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/11) ∧
    stopLoss (laplacianSpectrum graph) (2-2/11) ≤ ((43157602141/5905580032) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
