theorem actual_graph_bounds :
    ((18753137753/2684354560) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((18753138173/2684354560) : ℝ) := by
  have hi : graphDecidable=
      (fun i j => Classical.propDecidable (graph.Adj i j)) := Subsingleton.elim _ _
