theorem actual_graph_bounds :
    ((18994476263/2684354560) : ℝ) ≤ stopLoss (laplacianSpectrum graph) (2-2/10) ∧
    stopLoss (laplacianSpectrum graph) (2-2/10) ≤ ((18994476683/2684354560) : ℝ) := by
  have hi : graphDecidable=
